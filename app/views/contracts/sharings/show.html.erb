<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t(".title", name: @contract.name)) %>
  <% dialog.with_body do %>
    <p class="text-sm text-secondary mb-4"><%= t(".intro") %></p>
    <% if @family_members.any? %>
      <%= styled_form_with url: contract_sharing_path(@contract), method: :patch, class: "space-y-4" do |form| %>
        <div class="bg-container-inset rounded-xl p-1 space-y-2">
          <% @family_members.each_with_index do |member, index| %>
            <% share = @contract_shares[member.id] %>
            <div class="flex items-center gap-3 bg-container p-3 shadow-border-xs rounded-lg">
              <%= hidden_field_tag "sharing[members][#{index}][user_id]", member.id, id: nil %>
              <div class="w-8 h-8 rounded-full bg-surface-inset flex items-center justify-center text-xs font-medium text-secondary shrink-0">
                <%= member.initials %>
              </div>
              <span id="contract-member-<%= index %>" class="flex-1 min-w-0 truncate text-sm text-primary"><%= member.display_name %></span>
              <%= select_tag "sharing[members][#{index}][permission]",
                    options_for_select(contract_share_permission_options(member), share&.permission || "read_only"),
                    class: "form-field__input w-auto", "aria-labelledby": "contract-member-#{index}" %>
              <%= hidden_field_tag "sharing[members][#{index}][shared]", "0", id: nil %>
              <%= check_box_tag "sharing[members][#{index}][shared]", "1", share.present?,
                    class: "checkbox checkbox--light", "aria-label": t(".shared_with", name: member.display_name) %>
            </div>
          <% end %>
        </div>
        <p class="text-xs text-secondary"><%= t(".permissions_hint") %></p>
        <%= form.submit t(".save") %>
      <% end %>
    <% else %>
      <p class="text-sm text-secondary"><%= t(".no_members") %></p>
    <% end %>
  <% end %>
<% end %>
