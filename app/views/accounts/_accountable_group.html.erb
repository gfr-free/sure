<%# locals: (account_group:, mobile: false, all_tab: false, open: nil, sortable: false, **args) %>

<%# In sort mode the group is a row of its side's group list
    (accounts/sidebar_group_list), dragged by the grip next to it. %>
<%= tag.div id: account_group.dom_id(tab: all_tab ? :all : nil, mobile: mobile),
      class: ("flex items-start gap-1 rounded-lg" if sortable),
      data: { group_key: account_group.key, **(sortable ? sidebar_sortable_item_data("sortable-group-list", account_group.key) : {}) } do %>
  <% if sortable %>
    <%= render "accounts/sort_handle", list: "sortable-group-list", label: t("accounts.sidebar.reorder_group", group: account_group.name), class_name: "mt-1.5" %>
  <% end %>
  <% is_open = open.nil? ? (account_group.accounts.any? { |account| page_active?(account_path(account)) } || Current.user.always_expanded_account_group?(account_group.key)) : open %>
  <%= tag.div class: ("min-w-0 grow" if sortable) do %>
    <%= render DS::Disclosure.new(align: :left, open: is_open) do |disclosure| %>
      <% disclosure.with_summary_content do %>
        <div class="flex items-center gap-3">
          <%= icon "chevron-right", class: "group-open:transform group-open:rotate-90" %>
          <%= tag.span class: class_names("text-sm text-primary font-medium", "animate-pulse" => account_group.syncing?) do %>
            <%= account_group.name %>
          <% end %>
        </div>

        <div class="ml-auto text-right grow">
          <%= tag.p format_money(account_group.total_money), class: "text-sm font-medium text-primary privacy-sensitive" %>
          <% if account_group.type_group? %>
            <%= turbo_frame_tag "#{account_group.key}_sparkline", src: accountable_sparkline_path(account_group.key), loading: "lazy", data: sparkline_frame_data do %>
              <%= render "accounts/sparkline_loader" %>
            <% end %>
          <% else %>
            <%= render "accounts/group_sparkline_frame",
                  frame_id: "#{account_group.dom_id(tab: all_tab ? :all : nil, mobile: mobile)}_sparkline",
                  account_group: account_group %>
          <% end %>
        </div>
      <% end %>

      <% subgroups = account_subgroups(account_group, view: :sidebar) %>
      <% if subgroups.any? %>
        <%# Each group saves the order of its own subgroups, per second-level
            dimension. %>
        <%= tag.div class: "space-y-1",
            data: sortable ? sidebar_sortable_list_data("sortable-subgroup-list",
              url: reorder_groups_accounts_path(level: "subgroups", dimension: account_grouping_dimension(:sidebar), group: account_group.key),
              param: "keys") : {} do %>
          <% subgroups.each do |subgroup| %>
            <%= tag.div id: subgroup.dom_id(tab: all_tab ? :all : nil, mobile: mobile),
                  class: "space-y-1 rounded-lg",
                  data: { subgroup_key: subgroup.key.to_s, **(sortable ? sidebar_sortable_item_data("sortable-subgroup-list", subgroup.token) : {}) } do %>
              <%# Total above its sparkline, right-aligned like the account rows below. %>
              <div class="flex items-start justify-between gap-2 px-3 pt-2">
                <% if sortable %>
                  <%= render "accounts/sort_handle", list: "sortable-subgroup-list", label: t("accounts.sidebar.reorder_group", group: subgroup.name) %>
                <% end %>
                <%= tag.p subgroup.name, class: class_names("text-xs font-medium text-secondary truncate grow", "animate-pulse" => subgroup.syncing?) %>
                <div class="text-right shrink-0">
                  <%= tag.p format_money(subgroup.total_money), class: "text-xs font-medium text-secondary whitespace-nowrap privacy-sensitive" %>
                  <%= render "accounts/group_sparkline_frame",
                        frame_id: "#{subgroup.dom_id(tab: all_tab ? :all : nil, mobile: mobile)}_sparkline",
                        account_group: account_group,
                        subgroup: subgroup %>
                </div>
              </div>
              <%= render "accounts/sidebar_account_list", accounts: subgroup.accounts, account_group: account_group, sortable: sortable, subgroup: subgroup %>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <%= render "accounts/sidebar_account_list", accounts: account_group.accounts, account_group: account_group, sortable: sortable %>
      <% end %>

      <% if account_group.type_group? %>
        <div class="my-2">
          <%= render DS::Link.new(
          href: new_polymorphic_path(account_group.key, step: "method_select"),
          text: t("accounts.sidebar.new_account_group", account_group: account_group.accountable_type.singular_display_name.downcase),
          icon: "plus",
          full_width: true,
          variant: "ghost",
          frame: :modal,
          class: "justify-start"
        ) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
