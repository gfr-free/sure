<%# locals: (accounts:, account_group:, sortable: false, subgroup: nil) %>

<% if sortable %>
  <%# The order is saved per account type when grouped by account type, and
      per grouping dimension otherwise. A group or subgroup sends only its own
      accounts, which the server reorders among the positions they hold; the
      group and subgroup keys keep each a separate list, with its own save
      queue, while its copies in other tabs still mirror each other. %>
  <%= tag.div class: "space-y-1",
        data: sidebar_sortable_list_data("sortable-list",
          url: reorder_accounts_path(dimension: account_grouping_primary(:sidebar), group: account_group.key, subgroup: subgroup&.token),
          param: "account_ids") do %>
    <% accounts.each do |account| %>
      <%# Rows become draggable only in sort mode (account-sort-mode). %>
      <%= tag.div class: "flex items-center gap-1 rounded-lg", data: sidebar_sortable_item_data("sortable-list", account.id) do %>
        <%= render "accounts/sort_handle", list: "sortable-list", label: t("accounts.sidebar.reorder_account", account: account.name) %>
        <%= render "accounts/sidebar_account", account: account, color: account_group.color_for(account), link_class: "min-w-0 grow" %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <div class="space-y-1">
    <% accounts.each do |account| %>
      <%= render "accounts/sidebar_account", account: account, color: account_group.color_for(account) %>
    <% end %>
  </div>
<% end %>
