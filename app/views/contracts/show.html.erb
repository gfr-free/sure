<%= content_for :page_title, @contract.name %>

<% editable = @contract.editable_by?(Current.user) %>
<% manageable = @contract.manageable_by?(Current.user) %>

<div class="space-y-4 pb-6 lg:pb-12">
  <%= link_to contracts_path, class: "inline-flex items-center gap-1 text-sm text-secondary hover:text-primary" do %>
    <%= icon "chevron-left", size: "sm" %>
    <%= t(".back") %>
  <% end %>

  <header class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-3 min-w-0">
      <%= contract_avatar(@contract) %>
      <div class="min-w-0 space-y-1">
        <h1 class="text-xl font-medium text-primary truncate"><%= @contract.name %></h1>
        <p class="text-sm text-secondary">
          <%= contract_kind_label(@contract.kind) %> &middot; <%= @contract.provider_display_name %>
        </p>
        <div class="flex flex-wrap items-center gap-2">
          <%= contract_status_pill(@contract) %>
          <% if @contract.owner_id != Current.user.id %>
            <%= render DS::Pill.new(label: t(".owned_by", name: @contract.owner.display_name), tone: :neutral, marker: false, icon: "users") %>
          <% end %>
        </div>
      </div>
    </div>

    <% if editable %>
      <%= render DS::Menu.new do |menu| %>
        <% menu.with_item(variant: "link", text: t(".edit"), icon: "pencil", href: edit_contract_path(@contract), data: { turbo_frame: :modal }) %>
        <% if manageable %>
          <% menu.with_item(variant: "link", text: t(".share"), icon: "share-2", href: contract_sharing_path(@contract), data: { turbo_frame: :modal }) %>
        <% end %>
        <% if @contract.active? && @contract.open? %>
          <% menu.with_item(variant: "link", text: t(".record_cancellation"), icon: "file-signature", href: new_contract_cancellation_path(@contract), data: { turbo_frame: :modal }) %>
        <% end %>
        <% unless @contract.ended? %>
          <% menu.with_item(variant: "button", text: t(".mark_ended"), icon: "ban", href: mark_ended_contract_path(@contract), method: :patch,
                            confirm: t(".confirm_mark_ended", name: @contract.name)) %>
        <% end %>
        <% if manageable %>
          <% menu.with_item(variant: "button", text: t(".delete"), icon: "trash-2", href: contract_path(@contract), method: :delete, destructive: true,
                            confirm: t(".confirm_delete", name: @contract.name)) %>
        <% end %>
      <% end %>
    <% end %>
  </header>

  <%= render "contracts/cancellation_notice", contract: @contract, editable: editable %>

  <% if @duplicates.any? %>
    <%= render DS::Alert.new(variant: :warning, message: t(".possible_duplicate", names: @duplicates.map(&:name).to_sentence)) %>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 items-start">
    <%= render DS::Card.new(class: "space-y-3") do %>
      <h2 class="text-sm font-medium text-primary"><%= t(".contract_section") %></h2>
      <dl class="space-y-2">
        <% if (number = contract_number_for(@contract, :contract_number)) %>
          <%= render DS::DetailRow.new(label: Contract.human_attribute_name(:contract_number), value: number, value_class: "privacy-sensitive") %>
        <% end %>
        <% if (number = contract_number_for(@contract, :customer_number)) %>
          <%= render DS::DetailRow.new(label: Contract.human_attribute_name(:customer_number), value: number, value_class: "privacy-sensitive") %>
        <% end %>
        <% if @contract.started_on %>
          <%= render DS::DetailRow.new(label: Contract.human_attribute_name(:started_on), value: l(@contract.started_on, format: :long)) %>
        <% end %>
        <%= render DS::DetailRow.new(label: Contract.human_attribute_name(:minimum_term_months), value: contract_minimum_term(@contract)) %>
        <%= render DS::DetailRow.new(label: Contract.human_attribute_name(:notice_period_value), value: contract_notice(@contract)) %>
        <%= render DS::DetailRow.new(label: t(".renewal"), value: contract_renewal(@contract)) %>
        <% if @contract.renewal_anchor_on %>
          <%= render DS::DetailRow.new(label: Contract.human_attribute_name(:renewal_anchor_on), value: l(@contract.renewal_anchor_on, format: :long)) %>
        <% end %>
        <% if @contract.ends_on %>
          <%= render DS::DetailRow.new(label: Contract.human_attribute_name(:ends_on), value: l(@contract.ends_on, format: :long)) %>
        <% end %>
        <% if @contract.account && Current.user.accessible_accounts.exists?(id: @contract.account_id) %>
          <%= render DS::DetailRow.new(label: Contract.human_attribute_name(:account)) do |row| %>
            <% row.with_value { link_to @contract.account.name, account_path(@contract.account), class: "underline" } %>
          <% end %>
        <% end %>
        <% if @contract.replaced_by&.viewable_by?(Current.user) %>
          <%= render DS::DetailRow.new(label: Contract.human_attribute_name(:replaced_by)) do |row| %>
            <% row.with_value { link_to @contract.replaced_by.name, contract_path(@contract.replaced_by), class: "underline" } %>
          <% end %>
        <% end %>
      </dl>
    <% end %>

    <%= render DS::Card.new(class: "space-y-3") do %>
      <div class="flex items-center justify-between gap-2">
        <h2 class="text-sm font-medium text-primary"><%= t(".payments_section") %></h2>
        <p class="text-sm text-secondary privacy-sensitive"><%= contract_annual_cost([ @annual_cost, @unconvertible_count ]) %></p>
      </div>
      <% if @visible_bills.any? %>
        <ul class="divide-y divide-subdued">
          <% @visible_bills.each do |bill| %>
            <li class="py-2 flex items-center justify-between gap-3">
              <%= link_to bill.display_name, bill_path(bill), class: "text-sm text-primary hover:underline truncate" %>
              <div class="text-right shrink-0">
                <p class="text-sm text-primary privacy-sensitive"><%= format_money(bill.amount_money.abs) %></p>
                <p class="text-xs text-secondary">
                  <%= bill.active? ? t(".next_due", date: l(bill.next_expected_date, format: :short)) : t("recurring_transactions.status.#{bill.status}") %>
                </p>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-secondary"><%= t(".no_payments") %></p>
      <% end %>
      <% if @hidden_bills %>
        <p class="text-xs text-secondary"><%= t(".hidden_payments") %></p>
      <% end %>
      <% if editable %>
        <div class="flex flex-wrap gap-2">
          <%= render DS::Link.new(text: t(".link_payments"), icon: "link", variant: "outline", size: :sm, href: edit_contract_path(@contract), frame: :modal) %>
          <%= render DS::Link.new(text: t(".add_payment"), icon: "plus", variant: "ghost", size: :sm, href: new_recurring_transaction_path, frame: :modal) %>
        </div>
      <% end %>
    <% end %>

    <% if [ @contract.portal_url, @contract.service_phone, @contract.service_email, @contract.claims_phone ].any?(&:present?) %>
      <%= render DS::Card.new(class: "space-y-3") do %>
        <h2 class="text-sm font-medium text-primary"><%= t(".contacts_section") %></h2>
        <dl class="space-y-2">
          <% if @contract.portal_url.present? %>
            <%= render DS::DetailRow.new(label: Contract.human_attribute_name(:portal_url)) do |row| %>
              <% row.with_value { link_to URI.parse(@contract.portal_url).host, @contract.portal_url, target: "_blank", rel: "noopener noreferrer", class: "underline" } %>
            <% end %>
          <% end %>
          <% if @contract.service_phone.present? %>
            <%= render DS::DetailRow.new(label: Contract.human_attribute_name(:service_phone)) do |row| %>
              <% row.with_value { link_to @contract.service_phone, "tel:#{@contract.service_phone.gsub(/[^\d+]/, "")}", class: "underline" } %>
            <% end %>
          <% end %>
          <% if @contract.claims_phone.present? %>
            <%= render DS::DetailRow.new(label: Contract.human_attribute_name(:claims_phone)) do |row| %>
              <% row.with_value { link_to @contract.claims_phone, "tel:#{@contract.claims_phone.gsub(/[^\d+]/, "")}", class: "underline" } %>
            <% end %>
          <% end %>
          <% if @contract.service_email.present? %>
            <%= render DS::DetailRow.new(label: Contract.human_attribute_name(:service_email)) do |row| %>
              <% row.with_value { mail_to @contract.service_email, class: "underline" } %>
            <% end %>
          <% end %>
        </dl>
      <% end %>
    <% end %>

    <%= render "contracts/documents", contract: @contract, documents: @documents, editable: editable %>

    <% if @contract.notes.present? %>
      <%= render DS::Card.new(class: "space-y-2 lg:col-span-2") do %>
        <h2 class="text-sm font-medium text-primary"><%= Contract.human_attribute_name(:notes) %></h2>
        <p class="text-sm text-primary whitespace-pre-line"><%= @contract.notes %></p>
      <% end %>
    <% end %>
  </div>
</div>
