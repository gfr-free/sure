<%# locals: (frame_id:, account_group:, subgroup: nil) %>

<%# The frame id carries tab and sidebar (desktop/mobile), so every copy of a
    group on the page loads into its own frame. %>
<%= turbo_frame_tag frame_id,
      src: account_group_sparkline_path(
        classification: account_group.classification,
        group: account_group.key,
        subgroup: subgroup&.token,
        v: sidebar_group_sparkline_version(account_group, subgroup: subgroup, frame_id: frame_id)
      ),
      loading: "lazy",
      data: sparkline_frame_data do %>
  <%= render "accounts/sparkline_loader" %>
<% end %>
