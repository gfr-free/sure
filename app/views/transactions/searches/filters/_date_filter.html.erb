<%# locals: (form:) %>
<div class="p-3">
  <%= form.date_field :start_date,
                      placeholder: t(".start_date"),
                      value: @q[:start_date],
                      class: "block w-full border border-secondary rounded-md bg-container py-2 pl-3 pr-3 text-base sm:text-sm focus:border-secondary focus:ring-0 focus-ring" %>
  <%= form.date_field :end_date,
                      placeholder: t(".end_date"),
                      value: @q[:end_date],
                      class: "block w-full border border-secondary rounded-md bg-container py-2 pl-3 pr-3 text-base sm:text-sm mt-2 focus:border-secondary focus:ring-0 focus-ring" %>
</div>
