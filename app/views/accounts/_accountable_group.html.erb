<%# locals: (account_group:, mobile: false, all_tab: false, open: nil, **args) %>

<div id="<%= account_group.dom_id(tab: all_tab ? :all : nil, mobile: mobile) %>" data-group-key="<%= account_group.key %>">
  <% is_open = open.nil? ? (account_group.accounts.any? { |account| page_active?(account_path(account)) } || Current.user.always_expanded_account_group?(account_group.key)) : open %>
  <%= render DS::Disclosure.new(align: :left, open: is_open) do |disclosure| %>
    <% disclosure.with_summary_content do %>
      <div class="flex items-center gap-3">
        <%= icon "chevron-right", class: "group-open:transform group-open:rotate-90" %>
        <%= tag.span class: class_names("text-sm text-primary font-medium", "animate-pulse" => account_group.syncing?) do %>
          <%= account_group.name %>
        <% end %>
      </div>

      <div class="ml-auto text-right grow">
        <%= tag.p format_money(account_group.total_money), class: "text-sm font-medium text-primary privacy-sensitive" %>
        <%= turbo_frame_tag "#{account_group.key}_sparkline", src: accountable_sparkline_path(account_group.key), loading: "lazy", data: { controller: "turbo-frame-timeout", turbo_frame_timeout_timeout_value: 10000 } do %>
          <div class="flex items-center w-8 h-4 ml-auto">
            <div class="w-6 h-px bg-loader"></div>
          </div>
        <% end %>
      </div>
    <% end %>

    <% sortable = Current.user&.account_order&.manual? %>
    <%= tag.div class: "space-y-1",
          data: sortable ? {
            controller: "account-sortable",
            account_sortable_group_value: account_group.key,
            account_sortable_url_value: reorder_accounts_path,
            action: "dragover->account-sortable#dragOver drop->account-sortable#drop account-sort-mode:stop@window->account-sortable#releaseKeyboard"
          } : {} do %>
      <% account_group.accounts.each do |account| %>
        <%= tag.div class: "flex items-center gap-1 rounded-lg",
              data: sortable ? {
                account_sortable_target: "item",
                account_id: account.id,
                action: "dragstart->account-sortable#dragStart dragend->account-sortable#dragEnd"
              } : {} do %>
        <% if sortable %>
          <%# A span rather than a button: Firefox does not start a drag from a
              <button> inside a draggable row. %>
          <%# Hidden until the sidebar is in sort mode (account-sort-mode). %>
          <%= tag.span role: "button",
                tabindex: 0,
                style: "display:none",
                class: "shrink-0 flex items-center justify-center w-6 h-6 rounded-md text-secondary hover:text-primary transition-colors cursor-grab active:cursor-grabbing touch-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-alpha-black-100",
                aria: { label: t("accounts.sidebar.reorder_account", account: account.name) },
                title: t("accounts.sidebar.reorder_hint"),
                data: {
                  account_sort_mode_target: "handle",
                  action: "mousedown->account-sortable#enableDrag touchstart->account-sortable#touchStart touchmove->account-sortable#touchMove touchend->account-sortable#touchEnd touchcancel->account-sortable#touchEnd keydown->account-sortable#handleKeyDown"
                } do %>
            <%= icon "grip-vertical", size: "sm" %>
          <% end %>
        <% end %>
        <%= link_to account_path(account),
                  class: class_names(
                    "block flex items-center gap-2 px-3 py-2 rounded-lg min-w-0 grow",
                    page_active?(account_path(account)) ? "bg-container" : "hover:bg-surface-hover"
                  ),
                  data: page_active?(account_path(account)) ? { active_account: true } : {},
                  draggable: sortable ? "false" : nil,
                  title: account.name do %>
          <%= render "accounts/logo", account: account, size: "sm", color: account_group.color %>

          <div class="min-w-0 grow">
            <div class="flex items-center gap-2 mb-0.5">
              <%= tag.p account.name, class: class_names("text-sm text-primary font-medium truncate", "animate-pulse" => account.syncing?) %>
              <% if account.shared? %>
                <%= icon("users", class: "w-3 h-3 text-secondary shrink-0") %>
              <% end %>
            </div>
            <%= tag.p account.short_subtype_label, class: "text-sm text-secondary truncate" %>
          </div>

          <div class="ml-auto text-right grow h-10">
            <%= tag.p format_money(account.balance_money), class: "text-sm font-medium text-primary whitespace-nowrap privacy-sensitive" %>
            <%= turbo_frame_tag dom_id(account, :sparkline), src: sparkline_account_path(account), loading: "lazy", data: { controller: "turbo-frame-timeout", turbo_frame_timeout_timeout_value: 10000 } do %>
              <div class="flex items-center w-8 h-4 ml-auto">
                <div class="w-6 h-px bg-loader"></div>
              </div>
            <% end %>
          </div>
        <% end %>
        <% end %>
      <% end %>
    <% end %>

    <div class="my-2">
      <%= render DS::Link.new(
      href: new_polymorphic_path(account_group.key, step: "method_select"),
      text: t("accounts.sidebar.new_account_group", account_group: account_group.accountable_type.singular_display_name.downcase),
      icon: "plus",
      full_width: true,
      variant: "ghost",
      frame: :modal,
      class: "justify-start"
    ) %>
    </div>
  <% end %>
</div>
