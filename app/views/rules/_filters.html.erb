<%# locals: (list_filter:, groups:) %>
<%# Filters in the browser (rules_filter_controller). The form only submits
    when Enter is pressed in the search, which reloads the same view. %>
<%= form_with url: rules_path, method: :get, class: "flex flex-col gap-2 mb-4", role: "search" do |form| %>
  <%= render DS::SearchInput.new(
    name: "q",
    value: params[:q],
    aria_label: t("rules.filters.search_label"),
    placeholder: t("rules.filters.search_placeholder"),
    data: { rules_filter_target: "input", filter_param: "q", action: "input->rules-filter#filter" }
  ) %>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-2">
    <% rule_filters(list_filter, groups).each do |filter| %>
      <%= render DS::Select.new(
        form: form,
        method: filter[:name],
        items: filter[:items],
        selected: filter[:selected],
        label: t("rules.filters.#{filter[:name]}.label"),
        html_options: { data: { rules_filter_target: "select", filter_param: filter[:name], action: "change->rules-filter#filter" } }
      ) %>
    <% end %>
  </div>

  <%= render DS::Link.new(
    text: t("rules.filters.reset"),
    variant: "ghost",
    href: rules_path,
    class: "hidden self-start",
    data: { rules_filter_target: "reset" }
  ) %>
<% end %>
