<%# locals: (list_filter:, groups:) %>
<% select_classes = "py-2 pl-3 pr-8 text-sm text-primary bg-container border border-secondary rounded-lg focus-ring" %>
<div class="flex flex-wrap items-center gap-2 mb-4" role="search">
  <%= render DS::SearchInput.new(
    aria_label: t("rules.filters.search_label"),
    placeholder: t("rules.filters.search_placeholder"),
    class: "flex-1 min-w-48",
    data: { rules_filter_target: "input", filter_param: "q", action: "input->rules-filter#filter" }
  ) %>

  <%= select_tag :status,
        options_for_select([ [ t("rules.filters.status.all"), "" ], [ t("rules.filters.status.active"), "active" ], [ t("rules.filters.status.inactive"), "inactive" ] ]),
        class: select_classes,
        aria: { label: t("rules.filters.status.label") },
        data: { rules_filter_target: "select", filter_param: "status", action: "change->rules-filter#filter" } %>

  <%= select_tag :action_type,
        options_for_select([ [ t("rules.filters.action_type.all"), "" ] ] + list_filter.action_type_options),
        class: select_classes,
        aria: { label: t("rules.filters.action_type.label") },
        data: { rules_filter_target: "select", filter_param: "action", action: "change->rules-filter#filter" } %>

  <%= select_tag :condition_type,
        options_for_select([ [ t("rules.filters.condition_type.all"), "" ] ] + list_filter.condition_type_options),
        class: select_classes,
        aria: { label: t("rules.filters.condition_type.label") },
        data: { rules_filter_target: "select", filter_param: "condition", action: "change->rules-filter#filter" } %>

  <% account_options = list_filter.account_options %>
  <% if account_options.any? %>
    <%= select_tag :account,
          options_for_select([ [ t("rules.filters.account.all"), "" ] ] + account_options),
          class: select_classes,
          aria: { label: t("rules.filters.account.label") },
          data: { rules_filter_target: "select", filter_param: "account", action: "change->rules-filter#filter" } %>
  <% end %>

  <% if groups.any? %>
    <%= select_tag :group,
          options_for_select([ [ t("rules.filters.group.all"), "" ], [ t("rules.filters.group.none"), "none" ] ] + groups.map { |group| [ group.name, group.id ] }),
          class: select_classes,
          aria: { label: t("rules.filters.group.label") },
          data: { rules_filter_target: "select", filter_param: "group", action: "change->rules-filter#filter" } %>
  <% end %>

  <%= render DS::Button.new(
    text: t("rules.filters.reset"),
    variant: "ghost",
    type: "button",
    class: "hidden",
    data: { rules_filter_target: "reset", action: "rules-filter#reset" }
  ) %>
</div>
