<%# locals: (transaction:, variant:, in_split_group: false) %>

<div id="<%= dom_id(transaction, "category_menu_#{variant}") %>" class="min-w-0 overflow-hidden">
  <% if transaction.category_editable? %>
    <%= render "categories/menu", transaction: transaction, in_split_group: in_split_group %>
  <% elsif transaction.category_set_on_transfer_outflow? %>
    <div class="hidden lg:flex" title="<%= t("transactions.transaction_category.set_on_outflow") %>">
      <%= render "categories/badge", category: transaction.transfer.outflow_transaction.category %>
    </div>
    <div class="flex lg:hidden" title="<%= t("transactions.transaction_category.set_on_outflow") %>">
      <%= render "categories/badge_mobile", category: transaction.transfer.outflow_transaction.category %>
    </div>
  <% else %>
    <div class="hidden lg:flex">
      <%= render "categories/badge", category: transaction.payment? ? payment_category : transfer_category %>
    </div>
    <div class="flex lg:hidden">
      <%= render "categories/badge_mobile", category: transaction.payment? ? payment_category : transfer_category %>
    </div>
  <% end %>
</div>
