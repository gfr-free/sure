<%# locals: (frame_id:, account_group:, subgroup: nil) %>

<%# The frame id carries tab and sidebar (desktop/mobile), so every copy of a
    group on the page loads into its own frame. Like the account and account
    type sparklines, the frame sits in a permanent wrapper, so a drawn chart
    survives a Turbo visit until its version changes. %>
<% version = sidebar_group_sparkline_version(account_group, subgroup: subgroup, frame_id: frame_id) %>
<%= tag.div id: sidebar_sparkline_wrapper_id(frame_id, "total", version), data: kept_element_data do %>
  <%= turbo_frame_tag frame_id,
        src: account_group_sparkline_path(
          classification: account_group.classification,
          group: account_group.key,
          subgroup: subgroup&.token,
          v: version
        ),
        loading: "lazy",
        data: sparkline_frame_data do %>
    <%= render "accounts/sparkline_loader" %>
  <% end %>
<% end %>
