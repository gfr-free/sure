<%= t(".heading", name: @contract.name) %>

<%= t(".intro", name: @contract.name, date: I18n.l(@guarantee_until, format: :long)) %>

<%= t(".days_left", count: @days_left) %>
<% if @contract.portal_url.present? %>

<%= t(".portal") %> <%= @contract.portal_url %>
<% end %>

<%= t(".cta") %>: <%= @contract_url %>

<%= t(".footer") %>
