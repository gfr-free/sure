<%# locals: (name:, value:, checked:, filter_name: nil, filter_data: { filter_name: filter_name }, checkbox_data: {}) %>
<%# One checkbox row in pages/dashboard/filter_popover. The caller yields the
    row's label; filter_name is what the popover's search matches against.
    A category row passes filter_data: category_search_data(category)
    instead, so it is found like in every other category picker. %>
<label class="filterable-item flex items-center gap-2 p-1.5 rounded-md hover:bg-container-inset-hover cursor-pointer" <%= tag.attributes(data: filter_data) %>>
  <%= check_box_tag name, value, checked, id: nil, class: "checkbox checkbox--light", data: checkbox_data %>
  <%= yield %>
</label>
