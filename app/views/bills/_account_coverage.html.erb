<%# locals: (forecasts:) %>
<%# One line per account: do its expected payments leave it above zero
    (Account::Forecast, decision E13)? A shortfall names the amount to move
    and links to the account's forecast. %>
<div class="bg-container rounded-xl shadow-border-xs p-4 space-y-2" data-testid="bills-account-coverage">
  <p class="text-xs font-medium uppercase tracking-wide text-secondary"><%= t(".title") %></p>

  <ul class="divide-y divide-subdued">
    <% forecasts.each do |forecast| %>
      <li class="flex items-center justify-between gap-4 py-2">
        <div class="min-w-0">
          <%= link_to forecast.account.name, account_path(forecast.account, tab: "forecast"), class: "text-sm text-primary truncate hover:underline" %>
          <p class="text-xs text-secondary">
            <% if forecast.shortfall? %>
              <%= t(".short", date: l(forecast.low_on, format: :short), by: l(forecast.top_up_by, format: :short)) %>
            <% else %>
              <%= t(".covered", date: l(forecast.ends_on, format: :short)) %>
            <% end %>
          </p>
        </div>
        <% if forecast.shortfall? %>
          <p class="text-sm font-medium text-destructive privacy-sensitive shrink-0">
            <%= t(".missing", amount: format_money(forecast.shortfall_amount)) %>
          </p>
        <% else %>
          <p class="text-sm text-primary privacy-sensitive shrink-0">
            <%= t(".left_over", amount: format_money(forecast.ending_balance)) %>
          </p>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
