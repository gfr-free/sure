<%# locals: (account_group:, mobile: false, all_tab: false, open: nil, sortable: false, **args) %>

<% copy = account_group.dom_id(tab: all_tab ? :all : nil, mobile: mobile) %>
<%# In sort mode the group is a row of its side's group list
    (accounts/sidebar_group_list), dragged by the grip next to it. %>
<%= tag.div id: copy,
      class: ("flex items-start gap-1 rounded-lg" if sortable),
      data: { group_key: account_group.key, **(sortable ? sidebar_sortable_item_data("sortable-group-list", account_group.key) : {}) } do %>
  <% if sortable %>
    <%= render "accounts/sort_handle", list: "sortable-group-list", label: t("accounts.sidebar.reorder_group", group: account_group.name), class_name: "mt-1.5" %>
  <% end %>
  <% is_open = open.nil? ? (account_group.accounts.any? { |account| page_active?(account_path(account)) } || Current.user.always_expanded_account_group?(account_group.key)) : open %>
  <%= tag.div class: ("min-w-0 grow" if sortable) do %>
    <%# The summary owns the name's slide: it is what a tap or keyboard focus
        lands on (sidebar_name_marquee_controller). %>
    <%= render DS::Disclosure.new(align: :left, open: is_open,
          summary_data: { controller: "sidebar-name-marquee",
                          action: "focus->sidebar-name-marquee#focus pointerup->sidebar-name-marquee#tap" }) do |disclosure| %>
      <% disclosure.with_summary_content do %>
        <%# The name gives way (truncating) to the total, so a long group name
            can't push the total out of line at a narrow sidebar width; the
            title shows the full name on hover. With no hover (a touch screen)
            or with keyboard focus, a cut name slides once to show its end
            (sidebar_name_marquee_controller). With reduced motion the name
            keeps its full width there instead, and a total that no longer
            fits moves to the line below, still on the right; a tap on a
            screen whose main pointer is fine does the same (the controller
            marks the summary data-name-revealed). %>
        <div class="flex items-center w-full min-w-0 gap-x-2 pointer-coarse:motion-reduce:flex-wrap [summary:focus-visible_&]:motion-reduce:flex-wrap in-data-name-revealed:flex-wrap">
          <div class="flex items-center gap-3 min-w-0 pointer-coarse:motion-reduce:shrink-0 pointer-coarse:motion-reduce:max-w-full [summary:focus-visible_&]:motion-reduce:shrink-0 [summary:focus-visible_&]:motion-reduce:max-w-full in-data-name-revealed:shrink-0 in-data-name-revealed:max-w-full">
            <%= icon "chevron-right", class: "shrink-0 group-open:transform group-open:rotate-90" %>
            <%= tag.span class: class_names("text-sm text-primary font-medium truncate pointer-coarse:motion-reduce:whitespace-normal [summary:focus-visible_&]:motion-reduce:whitespace-normal in-data-name-revealed:whitespace-normal", "animate-pulse" => account_group.syncing?),
                  title: account_group.name,
                  data: { sidebar_name_marquee_target: "name" } do %>
              <%= tag.span account_group.name, data: { sidebar_name_marquee_target: "text" } %>
            <% end %>
          </div>

          <div class="ml-auto text-right shrink-0">
            <%= tag.p format_money(account_group.total_money), class: "text-sm font-medium text-primary whitespace-nowrap privacy-sensitive" %>
            <% if account_group.type_group? %>
              <% group_version = sidebar_sparkline_versions(Current.family)[account_group.accountable_type] %>
              <%= tag.div id: sidebar_sparkline_wrapper_id(copy, "total", group_version), data: kept_element_data do %>
                <%= turbo_frame_tag "#{account_group.key}_sparkline",
                                    src: accountable_sparkline_path(account_group.key, v: group_version),
                                    loading: "lazy",
                                    data: sparkline_frame_data do %>
                  <div class="flex items-center w-8 h-4 ml-auto">
                    <div class="w-6 h-px bg-loader"></div>
                  </div>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% subgroups = account_subgroups(account_group, view: :sidebar) %>
      <% if subgroups.any? %>
        <%# Each group saves the order of its own subgroups, per second-level
            dimension. %>
        <%= tag.div class: "space-y-1",
            data: sortable ? sidebar_sortable_list_data("sortable-subgroup-list",
              url: reorder_groups_accounts_path(level: "subgroups", dimension: account_grouping_dimension(:sidebar), group: account_group.key),
              param: "keys") : {} do %>
          <% subgroups.each do |subgroup| %>
            <%= tag.div id: subgroup.dom_id(tab: all_tab ? :all : nil, mobile: mobile),
                  class: "space-y-1 rounded-lg",
                  data: { subgroup_key: subgroup.key.to_s, **(sortable ? sidebar_sortable_item_data("sortable-subgroup-list", subgroup.token) : {}) } do %>
              <div class="flex items-center justify-between gap-2 px-3 pt-2">
                <% if sortable %>
                  <%= render "accounts/sort_handle", list: "sortable-subgroup-list", label: t("accounts.sidebar.reorder_group", group: subgroup.name) %>
                <% end %>
                <%= tag.p subgroup.name, class: class_names("text-xs font-medium text-secondary truncate grow", "animate-pulse" => subgroup.syncing?) %>
                <%= tag.p format_money(subgroup.total_money), class: "text-xs font-medium text-secondary whitespace-nowrap privacy-sensitive" %>
              </div>
              <%= render "accounts/sidebar_account_list", accounts: subgroup.accounts, account_group: account_group, copy: copy, sortable: sortable, subgroup: subgroup %>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <%= render "accounts/sidebar_account_list", accounts: account_group.accounts, account_group: account_group, copy: copy, sortable: sortable %>
      <% end %>

      <% if account_group.type_group? %>
        <div class="my-2">
          <%= render DS::Link.new(
          href: new_polymorphic_path(account_group.key, step: "method_select"),
          text: t("accounts.sidebar.new_account_group", account_group: account_group.accountable_type.singular_display_name.downcase),
          icon: "plus",
          full_width: true,
          variant: "ghost",
          frame: :modal,
          class: "justify-start"
        ) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
